{
  "extends": "super-configs/tsconfig/base",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist"
  },
  "include": [
    "src",
    "tests",
    "stories",
    ".storybook/**/*.ts",
    "types",
    "tsup.config.ts",
    "vitest.config.ts"
  ]
}
